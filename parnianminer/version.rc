// parnianminer - Windows version information and icon
// Copyright 2026 Amir Reza Zamani <amirrezazamani@gmail.com>
// https://parniancoin.com
//
// Executables without version information are treated with more suspicion by
// antivirus heuristics. Keep these values in sync with BuildInfo.h.

#include <winver.h>

#define PM_VER_BIN     2,4,0,0
#define PM_VER_STR     "2.4.0.0"

1 ICON "ParnianCoinScreenSaver.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PM_VER_BIN
 PRODUCTVERSION PM_VER_BIN
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ParnianCoin"
            VALUE "FileDescription",  "ParnianCoin CPU miner (RandomHash)"
            VALUE "FileVersion",      PM_VER_STR
            VALUE "InternalName",     "parnianminer"
            VALUE "LegalCopyright",   "Copyright 2026 Amir Reza Zamani <amirrezazamani@gmail.com>"
            VALUE "OriginalFilename", "parnianminer.exe"
            VALUE "ProductName",      "parnianminer"
            VALUE "ProductVersion",   PM_VER_STR
            VALUE "Comments",         "https://parniancoin.com"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
